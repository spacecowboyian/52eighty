---
import Layout from '../layouts/Layout.astro';
import { Band, SectionHeader, Pillar, Arch, archMedia, Wordmark } from '5280-design-system';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Copy is the brand guide's own (pp3–5): the positioning paragraph, the five
// expanded messaging pillars, and the closing line. Q4 for Ian: keep as-is or
// re-voice; the CMS `aboutText` used to stand in here and is no longer read.
const PILLARS = [
  {
    title: 'Below the surface',
    lead: 'We believe the best creative work starts below the obvious answer.',
    keyIdea: 'Better questions create better brands.',
    points: [
      'We dig deeper than logos and taglines',
      'We uncover the emotional core behind the work',
      'We help organizations identify hidden tensions, opportunities, and stories',
      'We believe meaningful creative starts with curiosity',
    ],
  },
  {
    title: 'Work people can feel',
    lead: 'We’re not interested in empty content or polished corporate noise.',
    keyIdea: 'Emotion creates connection.',
    points: [
      'We create work with heartbeat and personality',
      'We believe people remember how something made them feel',
      'We prioritize honesty, energy, and human connection',
      'We believe creative should move people emotionally before it asks them to act',
    ],
  },
  {
    title: 'Relationships. Not projects.',
    lead: 'The best creative work happens when trust exists first.',
    keyIdea: 'Strong relationships create stronger creative.',
    points: [
      'We care deeply about the people behind the project',
      'We value honesty and collaboration over ego',
      'We extend ourselves further than expected',
      'We believe trust allows organizations to tell better stories',
      'We believe people matter more than deliverables ever will',
    ],
  },
  {
    title: 'Great stories are worth chasing',
    lead: 'Most organizations already have a meaningful story.',
    keyIdea: 'The challenge is being willing to go far enough to uncover it.',
    points: [
      'We chase the deeper story beneath the surface',
      'We believe personality matters',
      'We believe strategy and storytelling should work together',
      'We create campaigns, films, and brands rooted in emotional truth',
    ],
  },
  {
    title: 'Create with conviction',
    lead: 'We believe safe creative rarely gets remembered.',
    keyIdea: 'Meaningful work requires courage.',
    points: [
      'We challenge surface-level thinking',
      'We care more about authenticity than trends',
      'We value timelessness over temporary attention',
      'We believe the best ideas usually live outside the safest rooms',
    ],
  },
];
---

<Layout title="About — 52Eighty Creative" headerTone="dark">
  {/* Guide p3: the positioning page, pine in a sky frame. */}
  <Band as="section" tone="pine" frame="sky" pad="lg" className="about-intro">
    <SectionHeader as="h1" variant="marker" title="A brand-first agency." eyebrow="About" eyebrowTone="lime" />
    <p class="t-lead about-intro__lead">
      52Eighty Creative helps organizations move beyond surface-level marketing by uncovering
      deeper stories, stronger emotional connections, and more meaningful creative direction.
    </p>
    <div class="about-intro__body">
      <p>
        At our core, we believe the best ideas usually exist a little further beyond the obvious
        answer. Most brands stop at safe messaging, generic campaigns, and polished-but-forgettable
        creative. We’re more interested in the version that feels human, emotionally honest, and
        alive.
      </p>
      <p>
        That means asking better questions. Digging deeper into the story. Understanding the
        people behind the project. Finding the tension, personality, and purpose that actually
        makes someone care.
      </p>
      <p>
        We don’t just create deliverables. We help organizations discover the heart behind what
        they do — then build strategy, campaigns, films, and brands that move people emotionally
        before they ever ask them to act.
      </p>
    </div>
  </Band>

  {/* Guide pp4–5: the pillars, jade in a sky frame. */}
  <Band as="section" tone="jade" frame="sky" pad="lg">
    <SectionHeader variant="marker" title="Expanded messaging pillars" eyebrow="How we think" eyebrowTone="sky" />
    <div class="pillars">
      {PILLARS.map((p, i) => <Pillar index={i + 1} {...p} />)}
    </div>
  </Band>

  {/* The people. Cream in a blush frame. The arch holds St. Joseph at golden
      hour from 5280's own footage until there's a photo of Miles & Alysa (Q6). */}
  <Band as="section" tone="cream" frame="blush" pad="lg">
    <div class="people">
      <Arch tone="sky" ratio="4 / 5" className="people__photo">
        <img
          src={`${base}/about/st-joseph-aerial-1000.jpg`}
          srcset={`${base}/about/st-joseph-aerial-500.jpg 500w, ${base}/about/st-joseph-aerial-1000.jpg 1000w`}
          sizes="(min-width: 640px) 40vw, 90vw"
          alt="Downtown St. Joseph, Missouri from the air at golden hour"
          loading="lazy"
          decoding="async"
          style={archMedia}
        />
      </Arch>
      <div class="people__copy">
        <SectionHeader variant="marker" title="Relationships. Not projects." eyebrow="Miles & Alysa Ramsay" eyebrowTone="blush" />
        <p class="t-body people__body">
          A husband-and-wife studio in St. Joseph, Missouri. We care about the people behind the
          project, we extend ourselves further than expected, and we’d rather earn a decade of
          trust than win a quarter.
        </p>
        <p class="t-heading people__close">Surface-level marketing is crowded. Good stories aren’t.</p>
        <div class="people__mark"><Wordmark tone="light" height={40} /></div>
      </div>
    </div>
  </Band>
</Layout>

<style>
  .about-intro__lead {
    color: #ffffff;
    max-width: 34ch;
    margin: 1.75rem 0 0;
    text-wrap: balance;
  }
  .about-intro__body {
    max-width: 60ch;
    margin-top: 1.5rem;
    color: #cfe2e0;
    font-family: var(--serif);
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .about-intro__body p {
    margin: 0 0 1em;
  }

  /* 1 → 2 → 3 columns, content-driven. */
  .pillars {
    display: grid;
    gap: 2.5rem 2rem;
    margin-top: 2.5rem;
  }

  .people {
    display: grid;
    gap: 2rem;
  }
  .people__body {
    color: #16211f;
    max-width: 52ch;
    margin: 1.25rem 0 0;
  }
  .people__close {
    color: #184a4f;
    max-width: 24ch;
    margin: 1.75rem 0 0;
    text-wrap: balance;
  }
  .people__mark {
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .people {
      grid-template-columns: 2fr 3fr;
      align-items: center;
    }
  }
  @media (min-width: 1024px) {
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

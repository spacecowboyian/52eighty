---
import Layout from '../../layouts/Layout.astro';
import { getAllCaseStudySlugs, getCaseStudyBySlug } from '../../utils/queries';
import { Band, SectionHeader, Arch, archMedia, bandTones, projectTone } from '5280-design-system';
import { coverFor, galleryFor } from '../../utils/covers';
import { categoryLabel } from '../../utils/categories';
import Invite from '../../components/Invite.astro';

export async function getStaticPaths() {
  const slugs = await getAllCaseStudySlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const caseStudy = await getCaseStudyBySlug(slug!);
const cover = caseStudy ? coverFor(caseStudy) : undefined;
const gallery = galleryFor(slug!);
// The same tone the card used on the grid, so the click lands where it left.
const tone = projectTone(slug!);
const headerTone = bandTones[tone].header;
// The eyebrow pill has to read on the header's field: sky on dark fields,
// pine on the light ones (sky on sky vanishes).
const pillTone = headerTone === 'dark' ? 'sky' : 'pine';
---

<Layout title={`${caseStudy?.title ?? 'Case Study'} — 52Eighty Creative`} headerTone={headerTone}>
  <Band as="header" tone={tone} pad="lg" className="cs-head">
    <div class="cs-head__grid">
      <div>
        <SectionHeader
          as="h1"
          variant="marker"
          eyebrow={categoryLabel(caseStudy?.category)}
          eyebrowTone={pillTone}
          title={caseStudy?.title}
        />
      </div>
      {/* Below the title on a phone, beside it from 768px. When Sanity carries
          a hero image, the Band's background slot is where it lands (seam B). */}
      <Arch tone={tone === 'sky' ? 'pine' : 'sky'} ratio="4 / 5" className="cs-head__cover">
        {cover && <img src={cover.src} srcset={cover.srcSet} sizes="(min-width: 768px) 40vw, 90vw" alt="" style={archMedia} />}
      </Arch>
    </div>
  </Band>

  {/* Seam C1: the cream body domes over the header's field. */}
  <Band as="article" tone="cream" pad="lg" edge="arch" className="cs-body">
    <p class="t-lead cs-body__summary">{caseStudy?.summary}</p>
    {
      gallery.length > 0 && (
        <div class="cs-gallery" aria-label="Stills from the work">
          {gallery.map((g) => (
            <Arch tone={tone} ratio="4 / 5">
              <img src={g.src} srcset={g.srcSet} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw" alt={g.alt} loading="lazy" decoding="async" style={archMedia} />
            </Arch>
          ))}
        </div>
      )
    }
  </Band>

  <Invite reveal={false} />
</Layout>

<style>
  .cs-head__grid {
    display: grid;
    gap: 2rem;
  }
  .cs-body__summary {
    color: #16211f;
    max-width: 60ch;
    margin: 0;
  }
  /* Stills from the footage, as arches: one up, then two, then three. */
  .cs-gallery {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 640px) {
    .cs-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .cs-gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) {
    .cs-head__grid {
      grid-template-columns: 3fr 2fr;
      align-items: end;
    }
  }
</style>

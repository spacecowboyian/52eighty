---
import Layout from '../../layouts/Layout.astro';
import { getAllCaseStudies } from '../../utils/queries';
import { SectionHeader, Card, projectTone } from '5280-design-system';
import { coverFor } from '../../utils/covers';
import Invite from '../../components/Invite.astro';

const caseStudies = await getAllCaseStudies();

// Internal links need the Pages base path — see Layout.astro.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Our Work — 52Eighty Creative">
  <section class="work">
    <SectionHeader
      as="h1"
      eyebrow="Portfolio"
      title="Our Work"
      subtitle="Branding, marketing campaigns, video, and social & digital work for clients who go further."
    />
    {
      caseStudies.length > 0 ? (
        <div class="work-grid">
          {caseStudies.map((cs) => (
            <a href={`${base}/work/${cs.slug}`} class="work-grid__link">
              <Card
                variant="work"
                titleAs="h2"
                eyebrow={cs.category}
                title={cs.title}
                blurb={cs.summary}
                image={coverFor(cs)}
                imageTone={projectTone(cs.slug)}
                client:load
              />
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">Case studies are on their way.</p>
      )
    }
  </section>
  <Invite reveal={false} />
</Layout>

<style>
  .work {
    padding: 2rem 0;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .work-grid__link {
    text-decoration: none;
    color: inherit;
  }
  .empty-state {
    color: var(--muted, #5c6b68);
    font-style: italic;
    margin-top: 1.5rem;
  }
</style>

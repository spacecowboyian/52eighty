---
import { existsSync } from 'node:fs';
import Layout from '../layouts/Layout.astro';
import { getSiteSettings, getFeaturedCaseStudies } from '../utils/queries';
import { SectionHeader, Card, Button, Band, Starburst, Squiggle, projectTone } from '5280-design-system';
import Invite from '../components/Invite.astro';
import { coverFor } from '../utils/covers';
import { categoryLabel } from '../utils/categories';

const settings = await getSiteSettings();
const featured = await getFeaturedCaseStudies();

// Internal links need the Pages base path — see Layout.astro.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The hero is built to be a reel. The reel itself doesn't exist yet — it's
// gated on Miles's work samples and is an explicit non-goal of issue #15 — so
// the slot is real and checked at build time: drop an encoded file at
// `public/reel/hero.mp4` (optionally `.webm` alongside it) and the hero plays
// it instead of the still, no code change. Until then the River Bluff Trails
// Park frame stands in, which is real 5280 work rather than stock.
const reelMp4 = existsSync('public/reel/hero.mp4');
const reelWebm = existsSync('public/reel/hero.webm');
const hasReel = reelMp4 || reelWebm;

// One word of the headline goes lime — the guide's "CREATIVE with a
// heartbeat" composition (p7). The first word, whatever the CMS says.
const heroTitle = settings?.heroTitle ?? 'Creative with a heartbeat.';
const [heroFirstWord, ...heroRest] = heroTitle.split(' ');
---

<Layout headerTone="dark">
  {/* Pine, not transparent: the media parallaxes up as the reel exits and the
      band's own colour is what shows beneath it — the same pine the scrim
      resolves into. */}
  <Band as="section" tone="pine" pad="none" className="reel" aria-label="52Eighty Creative">
    <div slot="background" class="reel__media">
      {
        hasReel ? (
          <video
            class="reel__drift"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={`${base}/intake/river-bluff-hero-1280.jpg`}
          >
            {reelWebm && <source src={`${base}/reel/hero.webm`} type="video/webm" />}
            {reelMp4 && <source src={`${base}/reel/hero.mp4`} type="video/mp4" />}
          </video>
        ) : (
          <img
            class="reel__drift"
            src={`${base}/intake/river-bluff-hero-2560.jpg`}
            srcset={`${base}/intake/river-bluff-hero-1280.jpg 1280w, ${base}/intake/river-bluff-hero-2560.jpg 2560w`}
            sizes="100vw"
            alt=""
            width="2560"
            height="1440"
            fetchpriority="high"
          />
        )
      }
    </div>

    <div class="reel__copy">
      {/* The guide's p7 composition: the starburst + heart sits at the
          headline's first word — beside it from 640px, above it on a phone. */}
      <div class="reel__mark"><Starburst size={72} heart pulse client:load /></div>
      <h1 class="reel__title t-display-xl">
        <span class="reel__accent">{heroFirstWord}</span> {heroRest.join(' ')}
      </h1>
      <p class="reel__lede">
        {
          settings?.heroText ??
          'Brand, film and campaign work for people building something worth the trip.'
        }
      </p>
      <p class="reel__cta">
        <Button href={`${base}/start`} variant="accent" size="lg" client:load>
          Start your project
        </Button>
      </p>
    </div>
  </Band>

  {/* Seam B above: the reel's scrim resolves into this band's pine. */}
  <Band as="section" tone="pine" pad="md" id="work" className="work">
    <SectionHeader variant="trail" title="Selected work" eyebrow="Portfolio" eyebrowTone="lime" />
    {
      featured.length > 0 ? (
        <div class="work-grid">
          {featured.map((cs) => (
            <a href={`${base}/work/${cs.slug}`} class="work-grid__link">
              <Card
                variant="work"
                eyebrow={categoryLabel(cs.category)}
                title={cs.title}
                blurb={cs.summary}
                image={coverFor(cs)}
                imageTone={projectTone(cs.slug)}
                client:load
              />
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state"><Starburst size={40} heart /> Case studies are on their way.</p>
      )
    }
    <p class="work__more">
      <a href={`${base}/work`}>All ten projects</a>
    </p>
  </Band>

  {/* Seam A: pine → jade, no rule. Guide p2, the statement page. */}
  <Band as="section" tone="jade" pad="md" reveal className="further">
    <h2 class="further__line t-display-md">
      <span class="further__accent">Go further.</span> It&rsquo;s less crowded out there.
    </h2>
    {/* The sky loop off the end of "there" — guide p2. Draws itself once. */}
    <div class="further__mark"><Squiggle draw width={200} client:load /></div>
    <p class="further__body">
      Branding, marketing campaigns, video, and social and digital strategy —
      but we don&rsquo;t sell them separately. Every project starts with the
      thing you&rsquo;re actually trying to make happen, and the work follows
      from there.
    </p>
  </Band>

  {/* Seam C1: the periwinkle invite domes over the jade. Then peri → pine
      footer is the page's one intentional hard edge — the full stop. */}
  <Invite />
</Layout>

<style>
  /* ----------------------------------------------------------------------
     Hero reel.

     Near-fullscreen, per the issue #15 tenet that the reel is the hero. It's
     a transparent `Band` with the media in the band's background slot, so
     it's full-bleed by construction and starts under the header; the page
     grid pays the header's height back as top padding.
     ---------------------------------------------------------------------- */
  .reel {
    min-height: 100svh;
    align-content: end;
    padding-bottom: clamp(3rem, 10vh, 6rem);
  }

  .reel__media {
    position: absolute;
    inset: 0;
    /* Pine under the media: the frame's own shadow, and the colour the scrim
       resolves into, so a slow image never flashes anything else. Clipped, so
       the drifting (scaled) frame can't poke out past the scrim when the
       parallax lifts the whole layer. */
    background: #184a4f;
    overflow: hidden;
  }

  .reel__media :is(img, video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bias the crop toward the rider so he survives the tall mobile crop and
       the open trail falls under the headline. Matches the intake hero. */
    object-position: 72% 50%;
  }

  /* The scrim is two layers rather than one flat wash: a bottom-weighted
     gradient that carries the type, and a wide soft vignette that keeps the
     frame from feeling cropped. Pine rather than black so it reads as the
     brand's own shadow. */
  .reel__media::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Seam B: the last stop is the next band's pine at 100%, so the photo
       resolves into the work band rather than stopping against it. */
    background:
      linear-gradient(
        to top,
        #184a4f 0%,
        rgba(24, 74, 79, 0.86) 14%,
        rgba(9, 18, 17, 0.58) 32%,
        rgba(9, 18, 17, 0.12) 64%,
        rgba(9, 18, 17, 0.28) 100%
      ),
      radial-gradient(
        120% 90% at 70% 40%,
        transparent 40%,
        rgba(24, 74, 79, 0.45) 100%
      );
  }

  /* The one continuous motion on the page: a slow, one-directional drift, the
     behaviour of a held drone shot rather than an effect. 32s, and it never
     returns to its start on a visible beat. Everything below the fold is
     still — motion is spent here or not at all. */
  .reel__drift {
    animation: reel-drift 32s ease-in-out infinite alternate;
    transform-origin: 68% 45%;
    will-change: transform;
  }

  /* Parallax as the reel leaves: CSS-only, scroll-driven, progressive — a
     browser without `animation-timeline` just scrolls it away normally. */
  @supports (animation-timeline: view()) {
    .reel__media {
      animation: reel-parallax linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 100%;
    }
    @keyframes reel-parallax {
      to {
        transform: translate3d(0, -12%, 0);
      }
    }
  }

  @keyframes reel-drift {
    from {
      transform: scale(1.04) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.12) translate3d(-1.5%, -1.2%, 0);
    }
  }

  /* The copy block doesn't cap the measure — the headline and lede each set
     their own, in their own type size. Capping here squeezed the display type
     into four lines with an orphaned "a". */
  .reel__copy {
    position: relative;
  }

  /* Size, weight, case and tracking come from `.t-display-xl` — the type is
     the design here, not a label on a picture. */
  .reel__title {
    color: #f4f1ea;
    /* ~2 lines at every size: "CREATIVE WITH A / HEARTBEAT." */
    max-width: 13ch;
    text-wrap: balance;
  }
  .reel__accent {
    color: #f0fc97;
  }
  /* Above the headline on a phone; beside its first word from 640px. */
  .reel__mark {
    line-height: 0;
    margin-bottom: 0.75rem;
  }
  .reel__mark :global(span) {
    width: 56px !important;
    height: 56px !important;
  }
  .reel__mark :global(svg) {
    width: 56px;
    height: 56px;
  }
  .reel__mark :global(svg + svg) {
    width: 20px;
    height: 20px;
  }

  .reel__lede {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 2.2vw, 1.375rem);
    line-height: 1.55;
    color: rgba(244, 241, 234, 0.86);
    max-width: 34ch;
    margin: 1.25rem 0 0;
  }

  .reel__cta {
    margin: 2rem 0 0;
  }

  /* The design-system Button sets its own inline styles, so reach the rendered
     anchor with :global — scoped selectors don't apply to island DOM. Without
     this the label breaks across two lines at 375px. */
  .reel__cta :global(a) {
    white-space: nowrap;
  }

  /* One orchestrated arrival on load — the headline settles, then the lede,
     then the call to action. Not repeated per section on scroll. */
  .reel__title,
  .reel__lede,
  .reel__cta {
    animation: reel-arrive 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
  }
  .reel__title {
    animation-delay: 0.1s;
  }
  .reel__lede {
    animation-delay: 0.28s;
  }
  .reel__cta {
    animation-delay: 0.44s;
  }

  @keyframes reel-arrive {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ----------------------------------------------------------------------
     Below the fold.
     ---------------------------------------------------------------------- */

  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  /* Cards carry summaries of different lengths, so let each one fill its grid
     row instead of ending wherever its text does — ragged card bottoms read as
     a layout bug rather than a choice. The link stretches (grid default) and
     the Card's own root element is stretched to match. */
  .work-grid__link {
    text-decoration: none;
    color: inherit;
    display: flex;
  }
  .work-grid__link :global(> div) {
    flex: 1;
  }

  .work__more {
    margin: 2rem 0 0;
    font-family: var(--ui);
  }
  .work__more a {
    color: #ffffff;
    text-decoration: none;
    border-bottom: 2px solid #f0fc97;
    padding-bottom: 2px;
    transition: border-color 0.2s var(--ease-out);
  }
  .work__more a:hover,
  .work__more a:focus-visible {
    border-color: #ffffff;
  }

  .empty-state {
    color: #cfe2e0;
    font-style: italic;
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .further__line {
    color: #ffffff;
    max-width: 16ch;
    text-wrap: balance;
  }
  .further__accent {
    color: #f0fc97;
  }
  .further__mark {
    color: #8cb6f2;
    display: flex;
    justify-content: flex-end;
    max-width: 16ch;
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    margin: -0.5rem 0 0;
    line-height: 0;
  }
  .further__mark :global(span) {
    width: clamp(7rem, 24vw, 12.5rem) !important;
  }

  .further__body {
    font-family: var(--serif);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.84);
    max-width: 44rem;
    margin: 1.25rem 0 0;
  }

  /* Two-up once there's room, three-up on a real desktop. Mobile-first: the
     single column above is the base state. */
  @media (min-width: 640px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .reel__copy {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 1.25rem;
      align-items: start;
    }
    .reel__mark {
      grid-row: 1;
      margin: 0.35em 0 0;
    }
    .reel__mark :global(span) {
      width: 72px !important;
      height: 72px !important;
    }
    .reel__mark :global(svg) {
      width: 72px;
      height: 72px;
    }
    .reel__mark :global(svg + svg) {
      width: 26px;
      height: 26px;
    }
    .reel__title {
      grid-column: 2;
    }
    .reel__lede,
    .reel__cta {
      grid-column: 2;
    }
  }

  @media (min-width: 1024px) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reel__drift {
      animation: none;
      transform: scale(1.04);
    }
    /* Scroll-driven animations have no duration for the global guard to
       zero, so switch the parallax off explicitly. */
    .reel__media {
      animation: none;
    }
    .reel__title,
    .reel__lede,
    .reel__cta {
      animation: none;
    }
  }
</style>

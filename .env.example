# Sanity project configuration
# Copy this to .env and fill in your values

# Sanity project ID (found in sanity.io/manage) — 52Eighty project: 0qwzjrfs
PUBLIC_SANITY_PROJECT_ID=0qwzjrfs

# Sanity dataset name (usually "production")
PUBLIC_SANITY_DATASET=production

# Adobe Fonts (Typekit) kit ID carrying the licensed brand faces — Crumb,
# Minion 3, Owners Narrow, Acumin Pro Wide, Larken Black, Mangrove Sans Bold.
# Leave unset and the self-hosted OFL stand-ins render instead.
PUBLIC_ADOBE_FONTS_KIT=
